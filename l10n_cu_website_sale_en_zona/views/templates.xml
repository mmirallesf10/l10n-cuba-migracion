<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="en_zona_confirmation" inherit_id="website_sale.payment_confirmation_status">
        <xpath expr="//div/div/div/t[3]" position="after">
            <t t-if="order.get_portal_last_transaction().provider_code == 'en_zona'">
                <t t-if="payment_tx_id.state == 'error'">
                    <t t-raw="payment_tx_id.state_message"/>
                </t>
            </t>
        </xpath>
    </template>
    <template id="en_zona_process_buttons" inherit_id="payment.manage">
         <xpath expr="//div[hasclass('card')]" position="inside">
            <t t-if="request.env['payment.transaction'].browse(payment_tx_ids).state in ['error', 'cancel']">
                <div class="col-sm-4 o_setting_box">
                    <div style="text-align: center">
                        <a role="button" class="btn btn-secondary float-left fa fa-chevron-left" t-att-href="'/shop'">Keep Shopping</a>
                    </div>
                    <br/><br/>
                    <div style="text-align: center">
                        <a role="button" class="btn btn-secondary float-left fa fa-chevron-left" t-att-href="'/shop/payment'">Return to confirm order</a>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
